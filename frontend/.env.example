# Local development only (npm run dev). Copy to .env - it is git-ignored.
# Nothing here is secret: the browser signs in against the backend and sends
# its own bearer token.

# Where the Vite dev server proxies /api: the NHI backend, which serves
# discovery (/api/v1), posture (/api/v1/ispm) and genome (/api/v1/genome).
API_UPSTREAM=http://localhost:8080

# Leave empty: the browser calls the same origin and the proxy routes it. Set
# only if the backend is served from a different origin.
VITE_API_URL=

# "true" opens the whole console without a connected AWS account and runs the
# Integrations page on sample accounts held in the browser. For review before
# the AWS side is deployed; leave unset (false) otherwise. `npm run
# dev:preview` sets it for you.
VITE_INTEGRATIONS_PREVIEW=
